PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nhatro
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/nhatro_test
# HS256 requires a non-placeholder secret of at least 32 UTF-8 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Replace this intentionally invalid placeholder in your local .env.
JWT_SECRET=replace-with-a-32-byte-or-longer-secret-key
