{
  "name": "roomify-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Roomify REST API (boarding-house search)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/database.js migrate",
    "migrate:test": "node scripts/database.js migrate --test",
    "db:check": "node scripts/database.js check",
    "db:check:test": "node scripts/database.js check --test",
    "test": "jest --runInBand",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
